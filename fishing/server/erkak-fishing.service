[Unit]
Description=erkak.com fishing leads API
After=network.target

[Service]
WorkingDirectory=/opt/erkak-fishing
EnvironmentFile=-/opt/erkak-fishing/.env
Environment=DATA_DIR=/opt/erkak-fishing/data
Environment=PORT=8796
ExecStart=/usr/bin/node /opt/erkak-fishing/leads.mjs
Restart=always
RestartSec=3
User=www-data
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/erkak-fishing/data

[Install]
WantedBy=multi-user.target
